{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CodeInk: doctor",
      "type": "process",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "${workspaceFolder}/dev.py",
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
